# Server Network Configuration
HOST=127.0.0.1
PORT=8080
MCP_TRANSPORT=stdio
# Comma-separated Host headers accepted on /mcp. Add your deployed hostname
# (wildcards like *.app.cloud.gov are allowed). /health and /version are exempt.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Data Paths (relative or absolute)
BABY_NAMES_DB_PATH=data/names.db
FIELD_OFFICES_CSV_PATH=data/FO-Address-Open-Close-Times.csv
APPOINTMENTS_DB_PATH=data/sandbox_appointments.db

# Live External APIs
CENSUS_BENCHMARK=Public_AR_Current
CENSUS_VINTAGE=Current_Current
# Optional free BLS registration key (https://data.bls.gov/registrationEngine/):
# switches to the v2 API (500 instead of ~25 requests/day). Never commit a real key.
# BLS_API_KEY=
